# Anthropic API key used to call Claude for email generation.
# Required for generation to succeed; without it, ingest still accepts rows
# but generation fails gracefully and the signal is marked status=error.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Shared secret Clay (or your curl test) must send as the X-Webhook-Secret
# header when calling POST /api/ingest. Pick any random string yourself,
# e.g. `openssl rand -hex 24`.
INGEST_SECRET=changeme

# Shared password for HTTP Basic Auth on the review UI and /api/sequences*.
# Any username is accepted; only the password is checked. Leave unset for
# local dev to disable auth entirely (matches pre-auth behavior). Pick any
# random string yourself, e.g. `openssl rand -hex 24`, before deploying
# publicly.
REVIEW_AUTH_PASSWORD=

# Port the Express server listens on.
PORT=3000

# Optional: override the Claude model used for generation.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: override the SQLite database file path. Defaults to
# ./data/app.db relative to the project root. On Render this should point at
# the mounted persistent disk, e.g. /data/app.db.
# DB_PATH=/data/app.db

# Optional: real Clay incoming-webhook URL to POST approved sequences to on
# approve. When unset, approve() instead POSTs the same flat payload shape to
# this app's own mock /api/clay-writeback endpoint, so the export step is
# always exercised even without a real destination configured.
# CLAY_WRITEBACK_URL=https://api.clay.com/v3/sources/webhook/your-webhook-id
