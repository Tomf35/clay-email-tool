From 2d061c5c88abcf654e1d4d638fbb3e32655317cd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 8 Sep 2026 17:46:14 +0000
Subject: [PATCH] Move Sequences/Raw Signals switcher to prominent buttons at
 the top

Replaces the subtle underlined-tab style (tucked into the topbar, easy to
miss) with a full-width navy bar at the very top of the page holding two
large pill buttons. Same click behavior as before (toggles between the
two queues), just far more visible.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015crp6GWRrqAmVAzBq9yxfy
---
 src/public/index.html |  9 +++++----
 src/public/styles.css | 34 +++++++++++++++++++++-------------
 2 files changed, 26 insertions(+), 17 deletions(-)

diff --git a/src/public/index.html b/src/public/index.html
index c14e432..fdc9bf7 100644
--- a/src/public/index.html
+++ b/src/public/index.html
@@ -10,6 +10,11 @@
 <link rel="stylesheet" href="/styles.css" />
 </head>
 <body>
+  <nav class="top-nav">
+    <button id="tabSequencesBtn" class="top-nav-btn active">Sequences</button>
+    <button id="tabRawSignalsBtn" class="top-nav-btn">Raw Signals</button>
+  </nav>
+
   <header class="topbar">
     <div class="brand">
       <img src="/assets/mintago-logo.webp" alt="Mintago" class="brand-logo" />
@@ -17,10 +22,6 @@
       <span class="brand-label">Outbound Review</span>
     </div>
     <div class="topbar-right">
-      <nav class="view-tabs">
-        <button id="tabSequencesBtn" class="view-tab active">Sequences</button>
-        <button id="tabRawSignalsBtn" class="view-tab">Raw signals</button>
-      </nav>
       <div class="filters" id="sequenceFilters">
         <label for="statusFilter">Status:</label>
         <select id="statusFilter">
diff --git a/src/public/styles.css b/src/public/styles.css
index 2fb1316..b65bfc0 100644
--- a/src/public/styles.css
+++ b/src/public/styles.css
@@ -77,20 +77,28 @@ body {
 }
 
 .topbar-right { display: flex; align-items: center; gap: 4px; }
-.view-tabs { display: flex; gap: 4px; margin-right: 16px; }
-.view-tab {
-  border-radius: 999px 999px 0 0;
-  border: 1px solid transparent;
-  background: none;
-  color: var(--mint-text-muted);
-  padding: 8px 16px;
+
+.top-nav {
+  display: flex;
+  gap: 10px;
+  background: var(--mint-navy);
+  padding: 14px 28px;
 }
-.view-tab:hover { background: var(--mint-cream); color: var(--mint-navy); }
-.view-tab.active {
-  background: var(--mint-cream);
-  color: var(--mint-navy);
-  border-color: var(--mint-border);
-  border-bottom-color: transparent;
+.top-nav-btn {
+  padding: 10px 22px;
+  border-radius: 999px;
+  border: 1.5px solid rgba(255, 255, 255, 0.25);
+  background: transparent;
+  color: var(--mint-white);
+  font-size: 14px;
+  font-weight: 700;
+  cursor: pointer;
+}
+.top-nav-btn:hover { background: rgba(255, 255, 255, 0.1); }
+.top-nav-btn.active {
+  background: var(--mint-coral);
+  border-color: var(--mint-coral);
+  color: #fff;
 }
 
 .filters { display: flex; gap: 8px; align-items: center; }
-- 
2.43.0

